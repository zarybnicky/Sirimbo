{
  "transforms": [
    {
      "mode": "sql",
      "include": "lib/**/*.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    },
    {
      "mode": "sql",
      "include": "app/**/*.sql",
      "emitTemplate": "{{dir}}/{{name}}.queries.ts"
    }
  ],
  "srcDir": ".",
  "failOnError": false,
  "camelCaseColumnNames": false
}

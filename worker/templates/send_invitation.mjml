<mjml>
  <mj-head>
    <mj-attributes>
      <mj-class name="background" background-color="#f5faff" font-size="13px" />
      <mj-class name="bold-text" align="center" font-size="20px" font-family="Helvetica" font-weight="bold" />
      <mj-class name="text" align="center" font-size="16px" font-family="Helvetica" />
      <mj-class name="small-text" align="center" font-size="13px" font-family="Helvetica" />
      <mj-class name="blue-section" background-color="#be9f69" />
      <mj-class name="white-section" background-color="#fff" />
    </mj-attributes>
  </mj-head>

  <mj-body mj-class="background">
    <mj-section padding-bottom="20px"></mj-section>

    <mj-section mj-class="blue-section">
      <mj-column width="100%">
        <mj-text mj-class="bold-text" color="#FFF" padding-left="25px" padding-right="25px">
          {{#if eventName}}Potvrzení přihlášky: {{eventName}}{{else}}Pozvánka do systému {{tenant}}{{/if}}
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="white-section">
      <mj-column width="100%">
        {{#if eventName}}
        <mj-text>Vaši přihlášku na akci {{eventName}} jsme přijali. Pro přístup ke své přihlášce a programu akce si vytvořte účet, nebo se přihlaste ke svému stávajícímu účtu.</mj-text>
        {{else}}
        <mj-text>Po otevření pozvánky si můžete vytvořit účet. Pokud už účet máte, stačí se přihlásit.</mj-text>
        <mj-text>V systému pak můžete prozkoumat informace na nástěnce, přihlašovat se na tréninky nebo na akce klubu.</mj-text>
        {{/if}}

        <mj-button mj-class="text" background-color="#be9f69" color="#FFF" font-weight="bold" border="none" padding="15px 30px" border-radius="10px" href="{{invitationLink}}" font-family="Helvetica" padding-left="25px" padding-right="25px" padding-bottom="10px">{{#if eventName}}Získat přístup k akci{{else}}Přijmout pozvánku{{/if}}</mj-button>
        <mj-text>({{invitationLink}})</mj-text>
      </mj-column>
    </mj-section>

    <mj-section mj-class="white-section">
      <mj-column width="100%">
        <mj-text>{{#if eventName}}Na stránku akce se můžete kdykoli vrátit:{{else}}Do systému se můžete kdykoli vrátit na adrese:{{/if}}</mj-text>

        <mj-button mj-class="text" background-color="#be9f69" color="#FFF" font-weight="bold" border="none" padding="15px 30px" border-radius="10px" href="{{homeLink}}" font-family="Helvetica" padding-left="25px" padding-right="25px" padding-bottom="10px">{{#if eventName}}{{eventName}}{{else}}{{domain}}{{/if}}</mj-button>
      </mj-column>
    </mj-section>

    <mj-section mj-class="blue-section">
      <mj-column width="100%">
        <mj-text mj-class="text" color="#FFF" padding-left="25px" padding-right="25px" padding-bottom="20px" padding-top="20px">
          S pozdravem<br/>
          {{tenant}}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
